{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyneurale.org/specifications/nrf/v1/head.schema.json",
  "title": "NRF v1 session head pointer",
  "description": "Rebuildable cache pointing at the current committed session state. It is not a journal record, carries no record_checksum, and is authoritative only as a cache: journal commit records and a valid checkpoint are authoritative. Its fields must equal the manifest commit cache and replay through journal_sequence.",
  "type": "object",
  "required": [
    "format",
    "version",
    "journal_sequence",
    "last_transaction_id",
    "last_checkpoint_id",
    "committed_extents",
    "sealed_targets"
  ],
  "properties": {
    "format": { "const": "nrf-head" },
    "version": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      },
      "additionalProperties": false
    },
    "journal_sequence": { "$ref": "#/$defs/nonNegativeSafeInteger" },
    "last_transaction_id": {
      "type": ["string", "null"],
      "pattern": "^tx-[0-9]{16}$"
    },
    "last_checkpoint_id": {
      "type": ["string", "null"],
      "pattern": "^checkpoint-[0-9]{16}$"
    },
    "committed_extents": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/relativePath" },
      "additionalProperties": { "$ref": "#/$defs/nonNegativeSafeInteger" }
    },
    "sealed_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|/|$))(?![a-z0-9._-]*\\.(?:/|$))(?!\\.{1,2}(?:/|$))[a-z0-9._-]+(?:/(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|/|$))(?![a-z0-9._-]*\\.(?:/|$))(?!\\.{1,2}(?:/|$))[a-z0-9._-]+)*$"
    }
  }
}
